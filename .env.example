# Public Supabase configuration. These values may be bundled into the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose this value to the browser.
SUPABASE_SECRET_KEY=
AUTH_SESSION_SECRET=
# Google Calendar service account. Keep these values server-side.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Multiline keys may be stored with literal \n sequences in the environment.
GOOGLE_PRIVATE_KEY=
METRICS_TOKEN=
SERVICE_NAME=luna-web
PORT=3000

# Worker and Evolution API. Keep all values server-side. Readiness requires the configured instance to answer as `open`.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Destino dos pedidos de atendimento humano. Use E.164 brasileiro, com ou sem `+`.
HANDOFF_NOTIFICATION_PHONE=
# Mantenha false até homologar botões em Android, iOS, Web e Desktop.
EVOLUTION_INTERACTIVE_MESSAGES=false
OTP_ENCRYPTION_SECRET=
# Use the public HTTPS domain in production. `localhost` only works on this machine.
PORTAL_BASE_URL=https://agenda.sua-clinica.com.br
TRUST_PROXY=true
APP_REVISION=local
WORKER_HEALTH_PORT=3001
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=5
WORKER_LEASE_SECONDS=300
WORKER_DAILY_SUMMARY_HOUR=8
WORKER_CALENDAR_SYNC_INTERVAL_MS=60000
# `allowlist` para sandbox; `all` para atender qualquer cliente em produção.
WORKER_RECIPIENT_POLICY=allowlist
# Lista E.164 sem `+`, separada por virgulas. Obrigatória quando a política é `allowlist`.
WORKER_ALLOWED_RECIPIENTS=
LOG_LEVEL=info
# `auto` usa logs coloridos em terminais locais e JSON em producao/coleta.
LOG_FORMAT=auto
LOG_COLOR=auto
PROMETHEUS_RETENTION=7d
PROMETHEUS_PORT=9090

# Backup/restore automation (server-side agent only; never commit real values).
BACKUP_AGE_RECIPIENT=
BACKUP_DESTINATION_DIR=
BACKUP_AGE_IDENTITY_FILE=
RESTORE_CONFIRM_ISOLATED=

# Conversas naturais no WhatsApp (server-only). A readiness falha sem uma chave válida.
# Optional. Leave empty to use only structured, deterministic replies. When enabled, the model may only rephrase a verified FAQ.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
