# Identidade imutável da versão. Use o mesmo valor no build e no runtime.
IMAGE_TAG=2026.07.27-1
APP_REVISION=replace-with-git-sha-or-release-id
WEB_IMAGE_REPOSITORY=luna-web

# Exposição local para um proxy HTTPS instalado na VPS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
WEB_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=1.0

# Supabase público: estes dois valores também são incorporados durante o build.
NEXT_PUBLIC_SUPABASE_URL=https://replace.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace

# Secrets somente do servidor.
SUPABASE_SECRET_KEY=replace
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-at-least-24-random-characters

# URL pública HTTPS usada em links enviados aos pacientes.
PORTAL_BASE_URL=https://agenda.example.com.br
TRUST_PROXY=true

# Google Calendar.
GOOGLE_CALENDAR_ID=replace@example.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=replace-with-service-account-private-key

# Evolution recebe os webhooks no serviço web.
EVOLUTION_BASE_URL=https://evolution.example.com.br
EVOLUTION_API_KEY=replace
EVOLUTION_INSTANCE=replace

# Opcional. Sem a chave, o atendimento usa somente a base estruturada.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
LOG_LEVEL=info
LOG_FORMAT=json
LOG_COLOR=never
