# Identidade imutável da versão.
IMAGE_TAG=2026.07.27-1
APP_REVISION=replace-with-git-sha-or-release-id
WORKER_IMAGE_REPOSITORY=luna-worker
WORKER_MEMORY_LIMIT=512m
WORKER_CPU_LIMIT=0.75

# Banco e mensageria.
NEXT_PUBLIC_SUPABASE_URL=https://replace.supabase.co
SUPABASE_SECRET_KEY=replace
EVOLUTION_BASE_URL=https://evolution.example.com.br
EVOLUTION_API_KEY=replace
EVOLUTION_INSTANCE=replace
EVOLUTION_INTERACTIVE_MESSAGES=false

# Criptografia, links e métricas.
OTP_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
PORTAL_BASE_URL=https://agenda.example.com.br
METRICS_TOKEN=replace-with-at-least-24-random-characters

# Número da doutora em E.164 brasileiro, com ou sem o sinal de +.
HANDOFF_NOTIFICATION_PHONE=5513999999999

# Em homologação use allowlist. Em produção, `all` libera clientes reais.
WORKER_RECIPIENT_POLICY=allowlist
WORKER_ALLOWED_RECIPIENTS=5513999999999
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=5
WORKER_LEASE_SECONDS=300

# Opcional.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
LOG_LEVEL=info
LOG_FORMAT=json
LOG_COLOR=never
